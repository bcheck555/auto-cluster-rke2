#cloud-config
hostname: @@HOSTNAME@@
preserve_hostname: false
ssh_deletekeys: true
ssh_genkeytypes:
  - ed25519
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
users:
  - default
  - name: rke2lab
    gecos: RKE2 Isolated Lab Operator
    groups: [wheel]
    shell: /bin/bash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD: ALL"]
    ssh_authorized_keys:
      - @@SSH_PUBLIC_KEY_YAML@@
write_files:
  - path: /var/lib/autonomous-rke2/host-id
    owner: root:root
    permissions: "0600"
    content: @@HOST_ID_YAML@@
  - path: /etc/autonomous-rke2/instance.json
    owner: root:root
    permissions: "0600"
    content: @@INSTANCE_YAML@@
runcmd:
  - [systemctl, start, qemu-guest-agent.service]
  - [mkdir, -p, /etc/systemd/system/cloud-init.target.wants]
  - [ln, -sf, /etc/systemd/system/autonomous-image-validation.service, /etc/systemd/system/cloud-init.target.wants/autonomous-image-validation.service]
  - [systemctl, start, --no-block, autonomous-image-validation.service]
