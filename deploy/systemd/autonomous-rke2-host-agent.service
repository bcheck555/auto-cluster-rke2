[Unit]
Description=Self-forming offline RKE2 node
Wants=network-online.target
After=network-online.target cloud-config.service
ConditionPathExists=/etc/autonomous-rke2/node.json
ConditionPathExists=/etc/autonomous-rke2/enrollment-secret

[Service]
Type=simple
User=root
ExecStart=/usr/local/libexec/autonomous-rke2/host-agent -config /etc/autonomous-rke2/node.json
ExecStopPost=/usr/local/libexec/autonomous-rke2/host-agent -config /etc/autonomous-rke2/node.json -restrict
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=15s
TimeoutStopSec=60s
StateDirectory=autonomous-rke2
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=/var/lib/autonomous-rke2 /etc/rancher/rke2 /var/lib/rancher/rke2 /etc/systemd/system /etc/rancher/node

[Install]
WantedBy=multi-user.target
